# ==============================================================================
# LabPulse Environment Configuration Template (Module 17: Production Infrastructure)
# ==============================================================================
# Copy to .env and fill in values. NEVER commit real secrets or production .env to git.

# ------------------------------------------------------------------------------
# 1. Application Server Configuration
# ------------------------------------------------------------------------------
PORT=3000
NODE_ENV=production
APP_URL=https://labpulse.onrender.com

# Explicit CORS allowed origins (comma-separated, without trailing slashes)
# Required in production when API is invoked across domains or external clients
ALLOWED_ORIGINS=https://labpulse.onrender.com

# ------------------------------------------------------------------------------
# 2. Active Data Backend Configuration (PostgreSQL / Supabase)
# ------------------------------------------------------------------------------
# In production, DATA_BACKEND must be set to 'supabase'.
# LabPulse uses public PostgreSQL tables + RLS + server-side repositories.
DATA_BACKEND=supabase

# Supabase Project Credentials (Dashboard -> Settings -> API)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=

# SERVER-ONLY Service Role Secret (STRICTLY CONFIDENTIAL)
# NEVER expose this key to frontend JavaScript, client bundles, or logs.
# Backend repositories use this to execute server-authoritative RBAC logic.
SUPABASE_SERVICE_ROLE_KEY=

# Supabase JWT Secret (Dashboard -> Settings -> API -> JWT Settings)
# Used by Express middleware to verify Supabase Auth Bearer tokens
SUPABASE_JWT_SECRET=

# ------------------------------------------------------------------------------
# 3. Native JWT Authentication Secrets (Dual Auth / Session Management)
# ------------------------------------------------------------------------------
# Production REQUIRES >= 32-character high-entropy cryptographic secrets.
# Generate via: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# ------------------------------------------------------------------------------
# 4. Email Notification Transport
# ------------------------------------------------------------------------------
# Options: 'smtp' (production) | 'dev' (in-memory outbox for local testing)
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=LabPulse Operations <noreply@labpulse.edu>

# ------------------------------------------------------------------------------
# 5. Initial Administrator Provisioning (First Boot Only)
# ------------------------------------------------------------------------------
# Consumed once by `npm run seed:admin` during initial database setup, then unset.
ADMIN_NAME=Platform Administrator
ADMIN_EMAIL=admin@labpulse.edu
ADMIN_PASSWORD=

# ------------------------------------------------------------------------------
# 6. Legacy / Rollback Database (Deprecated - Testing Only)
# ------------------------------------------------------------------------------
# Optional: Only required for legacy regression test runners. Not used in production.
MONGODB_URI=
